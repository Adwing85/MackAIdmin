# Port des Servers
PORT=8080
# Pfad zur SQLite-Datenbank
DATABASE_PATH=./data/mackaidmin.db
# Erster Admin (wird nur angelegt, wenn noch keine Benutzer existieren)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=bitte-aendern
# Demo-Daten beim ersten Start einspielen (true/false)
SEED_DEMO=false
# Öffentliche Adresse (für den Redirect nach der Microsoft-Anmeldung)
# PUBLIC_URL=https://mackaidmin.firma.de
# Optional: Anmeldung mit Microsoft Entra ID (App-Registrierung, siehe README)
# ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
# ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
# ENTRA_CLIENT_SECRET=...
# Rollen für neue Personen ohne App-Rolle
# ENTRA_DEFAULT_ROLES=viewer
# Passwort-Anmeldung abschalten, sobald Entra ID eingerichtet ist
# LOCAL_LOGIN=false
# Optional: SSO über vorgeschalteten Proxy (z. B. oauth2-proxy). Header mit der E-Mail des Benutzers.
# AUTH_PROXY_HEADER=x-forwarded-email
# Optional: Admin-API-Key der Claude Console für den Sync der Claude-Code-Nutzung
# ANTHROPIC_ADMIN_KEY=sk-ant-admin01-...
# Cookies nur über HTTPS senden (in Produktion true)
COOKIE_SECURE=false
